# --- Events Provider API ---
PROVIDER_BASE_URL=https://events-provider.dev-2.python-labs.ru
# API-ключ из профиля в LMS (обязателен для реального API)
PROVIDER_API_KEY=your-api-key-from-lms
PROVIDER_TIMEOUT=10
# true — работать на встроенных моках, без обращения к реальному API
USE_PROVIDER_MOCK=true

# --- База данных ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/events_db

# --- Синхронизация ---
SYNC_DAILY_AT=03:00
# Запускать воркер внутри процесса API (в Docker — false, см. run.sh)
RUN_WORKER_IN_API=true

# --- Кэш мест ---
SEATS_CACHE_TTL=30

# --- Postgres для docker-compose ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=events_db